{
  "name": "simple-thermostat",
  "version": "4.5.1",
  "description": "A different take on the thermostat card for Home Assistant Lovelace UI",
  "main": "simple-thermostat.js",
  "type": "module",
  "repository": "git@github.com:Wheemer/simple-thermostat.git",
  "author": "Raymond Julin <raymond.julin@gmail.com> (original), Wheemer (maintainer)",
  "license": "MIT",
  "files": [
    "simple-thermostat.js",
    "src"
  ],
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "lit": "^3.3.3",
    "squirrelly": "^9.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-preset-env": "^11.6.0",
    "prettier": "^3.9.9",
    "rollup": "^4.64.0",
    "rollup-plugin-inject-process-env": "^1.3.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-postcss-lit": "^2.2.0",
    "ts-jest": "^29.4.14",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "test": "jest",
    "test:visual": "node scripts/visual-smoke.mjs",
    "verify": "npm test -- --runInBand && npm run typecheck && npm run build && npm run test:visual",
    "build": "cross-env NODE_ENV=production rollup -c",
    "build:prod": "cross-env NODE_ENV=production BUILD_TARGET=prod rollup -c",
    "build:debug": "cross-env BUILD_TARGET=debug rollup -c",
    "render:readme": "node scripts/render-readme-preview.mjs",
    "postversion": "npm run build",
    "dev": "concurrently 'npm:dev:*'",
    "dev:build": "cross-env BUILD_TARGET=debug rollup -c --watch",
    "dev:test": "jest --watchAll",
    "typecheck": "tsc6 --noEmit"
  },
  "prettier": {
    "printWidth": 80,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "3.15.2",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "svgo": "2.8.4"
  }
}
